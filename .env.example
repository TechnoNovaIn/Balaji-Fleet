INTANGLES_BASE_URL=https://external.balajitransports.in/api
INTANGLES_USERNAME=Intangleuser
INTANGLES_PASSWORD=replace-with-real-password-in-.env

DATABASE_URL=postgresql://localhost:5432/balaji

# Connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=20

# Ingest configuration
INGEST_BATCH_SIZE=5
LIVE_BATCH_SIZE=50
INGEST_DELAY_SECONDS=0.2
POLL_LOOKBACK_DAYS=1

# Security & CORS
BALAJI_ENV=dev
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
